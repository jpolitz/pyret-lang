GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_API_KEY=""
GOOGLE_SERVER_API_KEY=""
GOOGLE_APP_ID=""
BASE_URL="."
CURRENT_PYRET_RELEASE=""
PYRET="./js/cpo-main.jarr.js"
# TypeScript-compiler flavor (opt-in via ?compiler=ts on the embed URL --
# see editor.html; the embed library's `compiler` config option sets it).
