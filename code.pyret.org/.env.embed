PYRET_TS_COMPILER="./js/ts-compiler.js"
CPO_COMPILER="pyret"
POSTMESSAGE_ORIGIN="*"
SHARED_FETCH_SERVER="https://code.pyret.org"
APP_NAME=code.pyret.org
APP_DOMAIN=code.pyret.org
URL_FILE_MODE="all-remote"
IMAGE_PROXY_BYPASS="true"
